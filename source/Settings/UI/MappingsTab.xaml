<UserControl x:Class="Graviton.Settings.MappingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:savmodels="clr-namespace:Graviton.Models.Saves"
             xmlns:installmodel="clr-namespace:Graviton.Models.Install"
             xmlns:models="clr-namespace:Graviton.Models"
             xmlns:local="clr-namespace:Graviton"
             xmlns:loc="clr-namespace:Playnite"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="1600" d:DesignWidth="1600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- #region Mapping Button -->
            <Style x:Key="MappingRowStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBorder" Background="Transparent" BorderThickness="0.5" BorderBrush="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Graviton.TransparentMouseOverBackground.Colour}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Graviton.Background.Colour}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="MappingRowTemplate" DataType="{x:Type models:EmulatorMapping}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{DynamicResource Graviton.TransparentBackground.Colour}" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="0.5" VerticalAlignment="Top" Margin="0,1,9,0">
                        <Image Source="{Binding PlatformIcon}" Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RomMPlatform.DisplayName}" FontSize="16" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Emulator.Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Profile.Name}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportedEmulator}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Top" Margin="6,5,0,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Success.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString Enabled}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSetup}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString SetupIncomplete}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString Disabled}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </DataTemplate>
            <!-- #endregion -->

            <ObjectDataProvider x:Key="SaveLayoutTypesValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="savmodels:SaveLayoutTypes"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="InstallStyleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="installmodel:InstallStyles"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="InstallModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="installmodel:InstallMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5,10,5,5" Name="MappingPanel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Border HorizontalAlignment="Right" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="1"/>

        <!-- #region Mappings Select -->
        <StackPanel Grid.Column="0" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="MappingsTitle" Grid.Column="0" Text="{loc:LocalizedString MappingsTitle}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Name="SyncPlatformsButton" Click="SyncPlatforms_Click" Grid.Column="1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="SyncPlatformsIcon" Text="&#xf46a;" Margin="2" FontFamily="{DynamicResource NerdFont}"/>
                        <TextBlock Name="SyncPlatformsText" Text="{loc:LocalizedString SyncPlatforms}" Margin="2"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Name="MappingsSubtitle" Margin="5,5,0,0" Text="{loc:LocalizedString MappingsSubTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>

            <Button Name="AddNewMappingButton" Margin="5,15,5,5" Click="AddMapping_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Name="AddMappingIcon" Text="&#xea60;" Margin="2"  FontFamily="{DynamicResource NerdFont}"/>
                    <TextBlock Name="AddMappingText" Text="{loc:LocalizedString NewMapping}" Margin="2"/>
                </StackPanel>
            </Button>

            <ListBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping, ElementName=Root, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource MappingRowStyle}" ItemTemplate="{StaticResource MappingRowTemplate}"/>
        </StackPanel>
        <!-- #endregion -->

        <!-- #region Mapping Options -->
        <Grid Name="MappingOptions" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- #region Top Bar -->
            <Grid Grid.Row="0" Margin="10,10,5,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="6" Background="{DynamicResource Graviton.TransparentBackground.Colour}" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="0.5" VerticalAlignment="Top" Margin="0,1,9,0">
                    <Image Source="{Binding PlatformIcon}" Width="65" Height="65" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RomMPlatform.DisplayName}" FontSize="22" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding Emulator.Name}" FontSize="20" FontWeight="Medium" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Profile.Name}" FontSize="18" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImportedEmulator}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Click="DeleteMapping_Click" Grid.Column="3" Margin="5" HorizontalAlignment="Right" Width="40" Height="40">
                    <TextBlock Name="DeleteMappingIcon" FontSize="24" Text="&#xf05e8;" Foreground="{DynamicResource Graviton.Error.Colour}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <!-- #endregion -->

            <ScrollViewer Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- #region Configuration -->
                    <Border Grid.Row="0" Style="{StaticResource Graviton.SettingsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{loc:LocalizedString Configuration}" Grid.Column="0" Grid.Row="0" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Name="EnabledText" Text="{loc:LocalizedString Enabled}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Emulator -->
                            <TextBlock Name="EmulatorText" Text="{loc:LocalizedString Emulator}" FontWeight="SemiBold" FontSize="14" Margin="0,10,10,0" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Name="EmulatorCombobox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="2" Tag="{loc:LocalizedString NoEmulator}" ItemsSource="{Binding AvailableEmulators}" DisplayMemberPath="Name" SelectedItem="{Binding Emulator, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableEmulators.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvailableEmulators}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableEmulators.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvailableEmulators}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Name="NoEmulatorsIcon" Text="&#xea6c;" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.Error.Colour}" VerticalAlignment="Center"/>
                                <TextBlock Name="NoEmulatorsText" Margin="2,0,0,0" Text="{loc:LocalizedString NoEmulatorsSetup}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Graviton.Error.Colour}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Profile -->
                            <TextBlock Name="ProfileText" Text="{loc:LocalizedString Profile}" FontWeight="SemiBold" FontSize="14" Margin="10,10,0,0" Grid.Column="1" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Name="ProfileCombobox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="10,0,0,0" Grid.Column="1" Grid.Row="2" Tag="{loc:LocalizedString NoProfile}" ItemsSource="{Binding AvailableProfiles}" DisplayMemberPath="Name" SelectedItem="{Binding Profile, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImportedEmulator}" Value="True">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Grid.Column="1" Grid.Row="3">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomEmulator}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Name="CustomEmulatorIcon" Text="&#xea74;" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.Warn.Colour}"/>
                            <TextBlock Name="CustomEmulatorText" Margin="2,0,0,0" Text="{loc:LocalizedString CustomEmulatorSelected}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Graviton.Warn.Colour}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Platform -->
                            <TextBlock Name="PlatformText" Text="{loc:LocalizedString Platform}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="4" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Height="36" Padding="8,0" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Tag="{loc:LocalizedString NoPlatform}" ItemsSource="{Binding AvailablePlatforms}" DisplayMemberPath="DisplayName" SelectedItem="{Binding RomMPlatform, Mode=TwoWay}"/>

                            <TextBlock Name="ROMLocText" Text="{loc:LocalizedString ROMLoc}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="6" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ROMLocation" Grid.Column="0" Height="36" Padding="3,0" VerticalContentAlignment="Center" Text="{Binding DestinationPath, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString NoFolderPlaceholder}"/>
                                <Button Click="BrowseROMLocation_Click" Height="36" Margin="5,0,0,0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Name="BrowseROMLocationText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>


                        </Grid>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Options -->
                    <Border Grid.Row="1" Style="{StaticResource Graviton.SettingsCard}">
                        <StackPanel>
                            <TextBlock Name="OptionText" Text="{loc:LocalizedString Options}" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="ExtractArchiveROMsText" Text="{loc:LocalizedString AutoExtractROMs}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString AutoExtractROMsTooltip}"/>
                                <ToggleButton Grid.Column="1" Name="ExtractArchiveROMs" IsChecked="{Binding AutoExtract, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="Preferm3uText" Text="{loc:LocalizedString PreferM3U}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString PreferM3UTooltip}"/>
                                <ToggleButton Grid.Column="1" Name="Preferm3u" IsChecked="{Binding PreferM3U, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Margin="5,5" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                            
                            <!-- #region Updates -->
                            <TextBlock Name="UpdateText" Text="{loc:LocalizedString Updates}" Style="{StaticResource Graviton.SettingsSubHeader}" TextTrimming="CharacterEllipsis"/>

                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="UpdateInstallStyleText" Text="{loc:LocalizedString InstallMethod}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString InstallStyleTooltip}"/>
                                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource InstallStyleValues}}" SelectedItem="{Binding UpdateInstallStyle, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid> <!-- Update CLI selector -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateInstallStyle}" Value="CLI">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="UpdateCLIDefinitionText" Text="{loc:LocalizedString CLIInstaller}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString CLIDefinitionTooltip}"/>
                                <ComboBox VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="2" MinWidth="200" ItemsSource="{Binding CLIDefinitions}" DisplayMemberPath="Name" SelectedItem="{Binding UpdateCLIDefinition, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Update CLI user args -->
                            <ItemsControl ItemsSource="{Binding UpdateCLIUserArgs, Mode=TwoWay}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateCLIUserArgs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateCLIUserArgs}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Name="UpdateCLIArgsNameText" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource {x:Type TextBlock}}"/>
                                            <TextBox Grid.Column="2" Width="200" x:Name="UpdateCLIArgsValueText" Text="{Binding Value, Mode=TwoWay}" local:Placeholder.Text="-" Style="{StaticResource {x:Type TextBox}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid> <!-- Update TitleID selector -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateInstallStyle}" Value="MappedFolder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Name="UpdateTitleIDDefinitionText" Text="{loc:LocalizedString TitleIDInstaller}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString TitleIDDefinitionTooltip}"/>
                                <ComboBox  Grid.Column="1" Grid.Row="0" MinWidth="200" VerticalContentAlignment="Center" ItemsSource="{Binding TitleIDDefinitions}" DisplayMemberPath="Name" SelectedItem="{Binding UpdateTitleIDDefinition, Mode=TwoWay}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="UpdateTitleIDArgs" Text="{Binding UpdateTitleIDDefinition.RuntimeArgs, Mode=OneWay}" local:Placeholder.Text="{loc:LocalizedString ArgumentsPlaceholder}" IsEnabled="False"/>
                            </Grid>

                            <Grid> <!-- Update Install Path -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateInstallStyle}" Value="Folder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateInstallStyle}" Value="MappedFolder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Name="UpdatePathText" Text="{loc:LocalizedString InstallPath}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,15,0"/>
                                <TextBox Grid.Column="1" x:Name="UpdateInstallPathBox" Text="{Binding UpdateInstallPath, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString InstallPathPlaceholder}"/>
                                <Button Grid.Column="2" Click="BrowseUpdateInstallPath_Click">
                                    <TextBlock Name="BrowseUpdatePathText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </Button>

                                <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="5,5,15,5">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateTitleIDDefinition.PathNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateTitleIDDefinition.PathNote}" Value=" ">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UpdateTitleIDDefinition.PathNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock  Name="UpdatePathNoteIcon" Text="&#xf449;" FontFamily="{DynamicResource NerdFont}" FontSize="12" TextWrapping="Wrap" Margin="0,0,2,0"/>
                                    <TextBlock  Name="UpdatePathNote" Text="{Binding UpdateTitleIDDefinition.PathNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid>  <!-- Update Install Mode -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateInstallStyle}" Value="None">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="UpdateInstallModeText" Text="{loc:LocalizedString InstallMode}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString InstallModeTooltip}"/>
                                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource InstallModeValues}}" SelectedItem="{Binding UpdateInstallMode, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!--#endregion-->

                            <Separator Margin="10,5" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                            <!-- #region DLC -->
                            <TextBlock Name="DLCText" Text="{loc:LocalizedString DLC}" Style="{StaticResource Graviton.SettingsSubHeader}" TextTrimming="CharacterEllipsis"/>
                            
                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="DLCInstallStyleText" Text="{loc:LocalizedString InstallMethod}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString InstallStyleTooltip}"/>
                                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource InstallStyleValues}}" SelectedItem="{Binding DLCInstallStyle, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid> <!-- DLC CLI selector -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DLCInstallStyle}" Value="CLI">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="DLCCLIDefinitionText" Text="{loc:LocalizedString CLIInstaller}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString CLIDefinitionTooltip}"/>
                                <ComboBox VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="2" MinWidth="200" Tag="{loc:LocalizedString None}" ItemsSource="{Binding CLIDefinitions}" DisplayMemberPath="Name" SelectedItem="{Binding DLCCLIDefinition, Mode=TwoWay}"/>
                            </Grid>

                            <!-- DLC CLI User args -->
                            <ItemsControl ItemsSource="{Binding DLCCLIUserArgs, Mode=TwoWay}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DLCCLIUserArgs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DLCCLIUserArgs}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Name="UpdateCLIArgsNameText" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource {x:Type TextBlock}}"/>
                                            <TextBox Grid.Column="2" Width="200" x:Name="UpdateCLIArgsValueText" Text="{Binding Value, Mode=TwoWay}" local:Placeholder.Text="-" Style="{StaticResource {x:Type TextBox}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid> <!-- DLC TitleID selector -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DLCInstallStyle}" Value="MappedFolder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Name="DLCTitleIDDefinitionText" Text="{loc:LocalizedString TitleIDInstaller}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString TitleIDDefinitionTooltip}"/>
                                <ComboBox  Grid.Column="1" Grid.Row="0" MinWidth="200" VerticalContentAlignment="Center" ItemsSource="{Binding TitleIDDefinitions}" DisplayMemberPath="Name" SelectedItem="{Binding DLCTitleIDDefinition, Mode=TwoWay}"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" x:Name="DLCTitleIDArgs" Text="{Binding DLCTitleIDDefinition.RuntimeArgs, Mode=OneWay}" local:Placeholder.Text="{loc:LocalizedString ArgumentsPlaceholder}" IsEnabled="False"/>
                            </Grid>

                             <Grid> <!-- DLC install path -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DLCInstallStyle}" Value="Folder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DLCInstallStyle}" Value="MappedFolder">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Name="DLCInstallPathText" Text="{loc:LocalizedString InstallPath}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,15,0"/>
                                <TextBox Grid.Column="1" x:Name="DLCInstallPathBox" Text="{Binding DLCInstallPath, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString InstallPathPlaceholder}"/>
                                <Button Grid.Column="2" Click="BrowseDLCInstallPath_Click">
                                    <TextBlock Name="BrowseDLCPathText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </Button>

                                <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="5,5,15,5">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DLCTitleIDDefinition.PathNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DLCTitleIDDefinition.PathNote}" Value=" ">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DLCTitleIDDefinition.PathNote}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock  Name="DLCPathNoteIcon" Text="&#xf449;" FontFamily="{DynamicResource NerdFont}" FontSize="12" TextWrapping="Wrap" Margin="0,0,2,0"/>
                                    <TextBlock  Name="DLCPathNote" Text="{Binding DLCTitleIDDefinition.PathNote}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid> <!-- DLC install mode -->
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Graviton.SettingsToggleRow}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DLCInstallStyle}" Value="None">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="DLCInstallModeText" Text="{loc:LocalizedString InstallMode}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString InstallModeTooltip}"/>
                                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource InstallModeValues}}" SelectedItem="{Binding DLCInstallMode, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!--#endregion-->

                        </StackPanel>
                    </Border>
                    <!-- #endregion -->
                    
                    <!-- #region Saves -->
                    <Border Grid.Row="3" Style="{StaticResource Graviton.SettingsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Name="SaveOptionText" Text="{loc:LocalizedString Saves}" Grid.Column="0" Grid.Row="0" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right">
                                <TextBlock Name="EnableSaveSyncingText" Text="{loc:LocalizedString EnableMappingSaveSyncing}" FontWeight="SemiBold" FontSize="14" Margin="5" VerticalAlignment="Center" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                <ToggleButton Name="EnableSaves" IsChecked="{Binding EnableSaveSyncing, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Name="SaveLocText" Text="{loc:LocalizedString SaveLocation}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="SavePathBox" Text="{Binding SaveLocation, Mode=TwoWay}" Height="36" Padding="3,0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString NoFolderPlaceholder}"/>
                                <Button Click="BrowseSavesLocation_Click" Height="36" Margin="5,0,0,0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Name="BrowseSavesLocationText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,10,10,0" Grid.Column="0" Grid.Row="3">
                                <TextBlock Name="AutoDetectionStyleText" Text="{loc:LocalizedString AutoSaveDetection}" FontWeight="SemiBold" FontSize="14"  Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaveType}" Value="Auto">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Name="DetectedSaveStyle" Text="{loc:LocalizedString DetectedStyle}" FontWeight="SemiBold" FontSize="12"  Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Name="DetectedSaveStyleValue" Text="{Binding FoundSaveType}" FontWeight="SemiBold" FontSize="12"  Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                            </Grid>

                            <ComboBox Name="AutoDetectionStyleCombo" VerticalAlignment="Top" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,0" Grid.Column="0" Grid.Row="4" Tag="{loc:LocalizedString AutoSaveStylePlaceholder}" ItemsSource="{Binding Source={StaticResource SaveLayoutTypesValues}}" SelectedItem="{Binding SaveType, Mode=TwoWay}" ToolTip="{loc:LocalizedString AutoSaveDetectionTooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaveType}" Value="Folder">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SaveType}" Value="Card">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                            <Condition Binding="{Binding FoundSaveType}" Value="Folder" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                            <Condition Binding="{Binding FoundSaveType}" Value="Card" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                            <Condition Binding="{Binding FoundSaveType}" Value="{x:Null}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                    </StackPanel.Style>
                                    <TextBlock Name="SaveExtensionsText" Text="{loc:LocalizedString SaveExtensions}" FontWeight="SemiBold" FontSize="14" Margin="10,10,0,0" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{loc:LocalizedString Optional}" FontWeight="SemiBold" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="4" Margin="10,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaveType}" Value="Folder">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SaveType}" Value="Card">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                    <Condition Binding="{Binding FoundSaveType}" Value="Folder" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                    <Condition Binding="{Binding FoundSaveType}" Value="Card" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SaveType}" Value="Auto" />
                                                    <Condition Binding="{Binding FoundSaveType}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="TempExtentionBox" Height="36" Padding="3,0" Grid.Column="0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString NewExtensionPlaceholder}"/>
                                        <Button Click="AddWhitelistedExtension_Click" Grid.Column="1" Height="36" Margin="5,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock FontFamily="{DynamicResource NerdFont}" Text="&#xea60;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding WhitelistExtensions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ., Mode=TwoWay}" Grid.Column="0" Height="36" Padding="3,0" VerticalContentAlignment="Center"/>
                                                    <Button Click="DeleteWhitelistedExtension_Click" Grid.Column="1" Height="36" Margin="5,0,0,0" HorizontalAlignment="Right">
                                                        <TextBlock FontFamily="{DynamicResource NerdFont}" Text="&#xf01b4;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            <TextBlock Name="EmulatorNameText" Text="{loc:LocalizedString EmulatorSaveName}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="5" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Column="0" Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="EmulatorNameBox" Text="{Binding EmulatorSaveName, Mode=TwoWay}" Grid.Column="0" Height="36" Padding="3,0" VerticalContentAlignment="Center" IsEnabled="False"/>
                                <Button Click="EditEmulatorName_Click" Grid.Column="1" Height="36" Margin="5,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock Name="EditEmuNameText" FontFamily="{DynamicResource NerdFont}" Text="&#xea73;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal">
                                <TextBlock Name="CoreNameText" Text="{loc:LocalizedString SaveCoreName}" FontWeight="SemiBold" FontSize="14" Margin="10,10,0,0"  Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{loc:LocalizedString Optional}" FontWeight="SemiBold" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Grid.Row="6" Margin="10,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="CoreNameBox" Text="{Binding CoreSaveName, Mode=TwoWay}" Grid.Column="0" Height="36" Padding="3,0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString CoreNameNotApplicable}" IsEnabled="False"/>
                                <Button Click="EditCoreName_Click" Grid.Column="1" Height="36" Margin="5,0,0,0" HorizontalAlignment="Right">
                                    <TextBlock Name="EditCoreNameText" FontFamily="{DynamicResource NerdFont}" Text="&#xea73;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Column="0" Grid.Row="7" Orientation="Horizontal">
                                <TextBlock Name="SaveStateLocText" Text="{loc:LocalizedString SaveStateLocation}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0"  Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{loc:LocalizedString Optional}" FontWeight="SemiBold" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Grid Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="SaveStatePathBox" Text="{Binding SaveStateLocation, Mode=TwoWay}" Height="36" Padding="3,0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString NoFolderPlaceholder}"/>
                                <Button Click="BrowseSaveStateLocation_Click" Height="36" Margin="5,0,0,0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                        </Grid>
                    </Border>
                    <!-- #endregion -->

                </Grid>
            </ScrollViewer>

        </Grid>
        <!-- #endregion -->

    </Grid>

</UserControl>
