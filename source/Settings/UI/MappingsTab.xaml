<UserControl x:Class="Graviton.Settings.MappingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:savmodels="clr-namespace:Graviton.Models.Saves"
             xmlns:models="clr-namespace:Graviton.Models"
             xmlns:local="clr-namespace:Graviton"
             xmlns:loc="clr-namespace:Playnite"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- #region Mapping Button -->
            <Style x:Key="MappingRowStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBorder" Background="Transparent" BorderThickness="0.5" BorderBrush="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Graviton.TransparentMouseOverBackground.Colour}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Graviton.Background.Colour}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="MappingRowTemplate" DataType="{x:Type models:EmulatorMapping}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="{DynamicResource Graviton.TransparentBackground.Colour}" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="0.5" VerticalAlignment="Top" Margin="0,1,9,0">
                        <Image Source="{Binding PlatformIcon}" Width="32" Height="32" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Emulator.Name}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RomMPlatform.DisplayName}" FontSize="14" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Top" Margin="6,5,0,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Success.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString Enabled}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSetup}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString SetupIncomplete}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                        <Setter Property="ToolTip" Value="{loc:LocalizedString Disabled}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </DataTemplate>
            <!-- #endregion -->

            <ObjectDataProvider x:Key="SaveLayoutStyleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="savmodels:SaveLayoutStyle"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5,10,5,5" Name="MappingPanel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Border HorizontalAlignment="Right" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="1"/>

        <!-- #region Mappings Select -->
        <StackPanel Grid.Column="0" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="MappingsTitle" Grid.Column="0" Text="{loc:LocalizedString MappingsTitle}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Name="SyncPlatformsButton" Click="SyncPlatforms_Click" Grid.Column="1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="SyncPlatformsIcon" Text="&#xf46a;" Margin="2" FontFamily="{DynamicResource NerdFont}"/>
                        <TextBlock Name="SyncPlatformsText" Text="{loc:LocalizedString SyncPlatforms}" Margin="2"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Name="MappingsSubtitle" Margin="5,5,0,0" Text="{loc:LocalizedString MappingsSubTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>

            <Button Name="AddNewMappingButton" Margin="5,15,5,5" Click="AddMapping_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Name="AddMappingIcon" Text="&#xea60;" Margin="2"  FontFamily="{DynamicResource NerdFont}"/>
                    <TextBlock Name="AddMappingText" Text="{loc:LocalizedString NewMapping}" Margin="2"/>
                </StackPanel>
            </Button>

            <ListBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping, ElementName=Root, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource MappingRowStyle}" ItemTemplate="{StaticResource MappingRowTemplate}"/>
        </StackPanel>
        <!-- #endregion -->

        <!-- #region Mapping Options -->
        <Grid Name="MappingOptions" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- #region Top Bar -->
            <Grid Grid.Row="0" Margin="10,10,5,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="6" Background="{DynamicResource Graviton.TransparentBackground.Colour}" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="0.5" VerticalAlignment="Top" Margin="0,1,9,0">
                    <Image Source="{Binding PlatformIcon}" Width="65" Height="65" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Emulator.Name}" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RomMPlatform.DisplayName}" FontSize="20" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>

                <Button Click="DeleteMapping_Click" Grid.Column="3" Margin="5" HorizontalAlignment="Right" Width="40" Height="40">
                    <TextBlock Name="DeleteMappingIcon" FontSize="24" Text="&#xf05e8;" Foreground="{DynamicResource Graviton.Error.Colour}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <!-- #endregion -->

            <ScrollViewer Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- #region Configuration -->
                    <Border Grid.Row="0" Style="{StaticResource Graviton.SettingsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{loc:LocalizedString Configuration}" Grid.Column="0" Grid.Row="0" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Name="EnabledText" Text="{loc:LocalizedString Enabled}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Name="EmulatorText" Text="{loc:LocalizedString Emulator}" FontWeight="SemiBold" FontSize="14" Margin="0,10,10,0" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Height="36" Padding="8,0" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Tag="{loc:LocalizedString NoEmulator}" ItemsSource="{Binding AvailableEmulators}" DisplayMemberPath="Name" SelectedItem="{Binding Emulator, Mode=TwoWay}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableEmulators.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvailableEmulators}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableEmulators.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AvailableEmulators}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Name="NoEmulatorsIcon" Text="&#xea6c;" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.Error.Colour}" VerticalAlignment="Center"/>
                                <TextBlock Name="NoEmulatorsText" Margin="2,0,0,0" Text="{loc:LocalizedString NoEmulatorsSetup}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Graviton.Error.Colour}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Name="PlatformText" Text="{loc:LocalizedString Platform}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="4" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Height="36" Padding="8,0" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Tag="{loc:LocalizedString NoPlatform}" ItemsSource="{Binding AvailablePlatforms}" DisplayMemberPath="DisplayName" SelectedItem="{Binding RomMPlatform, Mode=TwoWay}"/>

                            <TextBlock Name="ROMLocText" Text="{loc:LocalizedString ROMLoc}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="6" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ROMLocation" Grid.Column="0" Height="36" Padding="3,0" VerticalContentAlignment="Center" Text="{Binding DestinationPath, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString NoFolderPlaceholder}"/>
                                <Button Click="BrowseROMLocation_Click" Height="36" Margin="5,0,0,0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Name="BrowseROMLocationText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>


                        </Grid>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Options -->
                    <Border Grid.Row="1" Style="{StaticResource Graviton.SettingsCard}">
                        <StackPanel>
                            <TextBlock Name="OptionText" Text="{loc:LocalizedString Options}" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="ExtractArchiveROMsText" Text="{loc:LocalizedString AutoExtractROMs}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString AutoExtractROMsTooltip}"/>
                                <ToggleButton Grid.Column="1" Name="ExtractArchiveROMs" IsChecked="{Binding AutoExtract, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="Preferm3uText" Text="{loc:LocalizedString PreferM3U}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" ToolTip="{loc:LocalizedString PreferM3UTooltip}"/>
                                <ToggleButton Grid.Column="1" Name="Preferm3u" IsChecked="{Binding UseM3U, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Saves -->
                    <Border Grid.Row="2" Style="{StaticResource Graviton.SettingsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="SaveOptionText" Text="{loc:LocalizedString Saves}" Grid.Column="0" Grid.Row="0" Style="{StaticResource Graviton.SettingsSectionHeader}" TextTrimming="CharacterEllipsis"/>

                            <Button Click="OpenSaveManager_Click" Grid.Column="1" Grid.Row="0" Margin="0,0,0,14" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="OpenSaveManagerIcon" Text="&#xf019;" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                                    <TextBlock Name="OpenSaveManagerText" Text="{loc:LocalizedString ManageSaves}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                                </StackPanel>
                              </Button>

                            <TextBlock Name="AutoDetectionStyleText" Text="{loc:LocalizedString AutoSaveDetection}" FontWeight="SemiBold" FontSize="14" Margin="0,10,10,0" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Name="AutoDetectionStyleCombo" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,0" Grid.Column="0" Grid.Row="2" Tag="{loc:LocalizedString AutoSaveStylePlaceholder}" ItemsSource="{Binding Source={StaticResource SaveLayoutStyleValues}}" SelectedItem="{Binding FindSaveLayout, Mode=TwoWay}" ToolTip="{loc:LocalizedString AutoSaveDetectionTooltip}"/>
                            <TextBlock Name="SaveExtensionsText" Text="{loc:LocalizedString SaveExtensions}" FontWeight="SemiBold" FontSize="14" Margin="10,10,0,0" Grid.Column="1" Grid.Row="1" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <TextBox Grid.Column="1" Grid.Row="2" Margin="10,0,0,0" VerticalAlignment="Center" Height="36" Padding="3,0" VerticalContentAlignment="Center" x:Name="SaveExtensionBox" Text="{Binding FindSaveFileExtensions, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString SaveExtensionsPlaceholder}"/>

                            <TextBlock Name="SaveLocText" Text="{loc:LocalizedString SaveLocation}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" Grid.Column="0" Grid.Row="3" Foreground="{DynamicResource Graviton.SubText.Colour}" TextTrimming="CharacterEllipsis"/>
                            <Grid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="SavePathBox" Text="{Binding SavePath, Mode=TwoWay}" Height="36" Padding="3,0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString NoFolderPlaceholder}"/>
                                <Button Click="Click_BrowseSaveDestination" Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Name="SaveLocButtonText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- #endregion -->

                </Grid>
            </ScrollViewer>

        </Grid>
        <!-- #endregion -->

    </Grid>

</UserControl>
