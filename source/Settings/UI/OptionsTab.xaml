<UserControl x:Class="Graviton.Settings.OptionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:models="clr-namespace:Graviton.Models.Saves"
             xmlns:local="clr-namespace:Graviton"
             xmlns:loc="clr-namespace:Playnite"
             xmlns:psdk="clr-namespace:Playnite.Desktop;assembly=Playnite.SDK"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="SaveConflictResolveValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:SaveConflictResolve"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="ScreenshotResolutionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:ScreenshotResolution"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Name="OptionsPanel" Margin="10">

            <!--#region Scanning -->
            <Border Style="{StaticResource Graviton.SettingsCard}">
                <StackPanel>
                    <TextBlock Name="LibraryScanningText" Text="{loc:LocalizedString LibraryScanning}" Style="{StaticResource Graviton.SettingsSectionHeader}" />

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="MergeROMText" Text="{loc:LocalizedString MergeROMs}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding MergeRevisions, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="KeepDeleteText" Text="{loc:LocalizedString KeepDeleted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding KeepDeletedGames, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="SkipDeletedText" Text="{loc:LocalizedString SkipDeleted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding SkipMissingFiles, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="ExcludeGenresText" Text="{loc:LocalizedString ExcludeGenres}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,15,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="ExcludeGenresBox" Text="{Binding ExcludeGenres, Mode=TwoWay}" local:Placeholder.Text="{loc:LocalizedString ExcludeGenresPlaceholder}"/>
                            <TextBlock x:Name="ExcludeGenresPlaceholderText" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource Graviton.SubText.Colour}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ExcludeGenresBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Installation -->
            <Border Style="{StaticResource Graviton.SettingsCard}">
                <StackPanel>
                    <TextBlock Name="InstallationText" Text="{loc:LocalizedString Installation}" Style="{StaticResource Graviton.SettingsSectionHeader}" />

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="Use7zText" Text="{loc:LocalizedString Use7z}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding Use7z, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,3,0,0" IsEnabled="{Binding Use7z}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PathTo7zText" Text="{Binding PathTo7z, Mode=TwoWay}" Margin="0,0,10,0" VerticalContentAlignment="Center" local:Placeholder.Text="{loc:LocalizedString NoExePlaceholder}"/>
                        <Button Grid.Column="1" Click="Browse7zPath_Click">
                            <TextBlock Name="Browse7zText" Text="{loc:LocalizedString Browse}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Status Sync -->
            <Border Style="{StaticResource Graviton.SettingsCard}">
                <StackPanel>
                    <TextBlock Name="StatusTitle" Text="{loc:LocalizedString StatusSync}" Style="{StaticResource Graviton.SettingsSectionHeader}" />

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="KeepStatusSyncedText" Text="{loc:LocalizedString KeepStatusSynced}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding KeepStatusSynced, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="KeepFavouritesSyncedText" Text="{loc:LocalizedString KeepFavouritesSynced}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding KeepFavouritesSynced, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="KeepPrivateNotesSyncedText" Text="{loc:LocalizedString KeepPrivateNotesSynced}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding KeepPrivateNotesSynced, Mode=TwoWay}" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="KeepPublicNotesSyncedText" Text="{loc:LocalizedString KeepPublicNotesSynced}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding KeepPublicNotesSynced, Mode=TwoWay}" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Save Syncing -->
            <Border Style="{StaticResource Graviton.SettingsCard}">
                <StackPanel>
                    <TextBlock Name="SaveSyncTitle" Text="{loc:LocalizedString SaveSync}" Style="{StaticResource Graviton.SettingsSectionHeader}" />

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="SaveSyncEnabledText" Text="{loc:LocalizedString EnableSaveSyncing}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding SaveSyncEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding SaveSyncEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="DownloadSaveOnLaunchText" Text="{loc:LocalizedString DownloadSaveOnLaunch}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding DownloadSaveOnLaunch, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding SaveSyncEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="UploadSaveOnFinishedText" Text="{loc:LocalizedString UploadSaveOnFinished}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding UploadSaveOnFinished, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding SaveSyncEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="ConflictStyleText" Text="{loc:LocalizedString SaveConflictsLabel}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource SaveConflictResolveValues}}" SelectedItem="{Binding SaveConflictStyle, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding SaveSyncEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="AutoCleanupSavesText" Text="{loc:LocalizedString AutoCleanOldSaves}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <psdk:NumericUpDown Grid.Column="1" Value="{Binding AutoCleanupSavesLimit, Mode=TwoWay}" Minimum="1" Maximum="100" Width="70" Margin="0,0,15,0" VerticalAlignment="Center" IsEnabled="{Binding AutoCleanupSaves}"/>
                        <ToggleButton Grid.Column="2" IsChecked="{Binding AutoCleanupSaves, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource Graviton.TransparentBackground.Colour}" Margin="0,12"/>

                    <TextBlock Name="ScreenshotTitle" Text="{loc:LocalizedString ScreenshotTitle}" Style="{StaticResource Graviton.SettingsSubHeader}"/>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding SaveSyncEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="ScreenCapText" Text="{loc:LocalizedString EnableScreenshots}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding CaptureScreenshots, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}" IsEnabled="{Binding CaptureScreenshots}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="MaxResolutionBox" Text="{loc:LocalizedString MaxResolutionTitle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Source={StaticResource ScreenshotResolutionValues}}" SelectedItem="{Binding ScreenshotResolution, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Margin="0,10,0,0" IsEnabled="{Binding CaptureScreenshots}">
                        <TextBlock Name="SecondsBeforeTitle" Text="{loc:LocalizedString SecondsBeforeTitle}" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        <TextBlock Name="SecondsBeforeSubTitle" Text="{loc:LocalizedString SecondsBeforeSubTitle}" Style="{StaticResource Graviton.SettingsHelperText}"/>
                        <Slider Name="ScreenshotMaxCapture" Margin="0,0,10,0" Value="{Binding SecondsBeforeSave}" VerticalAlignment="Center" Minimum="5" Maximum="60" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--#endregion-->

            <!--#region Save State Syncing -->
            <Border Style="{StaticResource Graviton.SettingsCard}">
                <StackPanel>
                    <TextBlock Name="SaveStateSyncTitle" Text="{loc:LocalizedString SaveStateSync}" Style="{StaticResource Graviton.SettingsSectionHeader}" />

                    <Grid Style="{StaticResource Graviton.SettingsToggleRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="SaveStateSyncEnabledText" Text="{loc:LocalizedString EnableSaveStateSyncing}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding SaveStateSyncEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!--#endregion-->

        </StackPanel>
    </ScrollViewer>
</UserControl>
