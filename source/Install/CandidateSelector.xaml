<UserControl x:Class="Graviton.Install.CandidateSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="450" d:DesignWidth="800"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TreeView}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeView}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type TreeViewItem}">
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="MainGrid" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >

        <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Margin="5,5,0,0" Text="{loc:LocalizedString Install}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>
                    <TextBlock Margin="5,5,0,0" Text="{Binding Category}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="5,10" Grid.Row="1" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="CandidatesNumber" Margin="5,5,0,0" Text="{Binding Candidates.Count}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>
                        <TextBlock Name="CandidatesFoundText" Margin="5,5,0,0" Text="{loc:LocalizedString CandidatesFound}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="{loc:LocalizedString DragToolTip}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Margin="5,10,5,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstallMode}" Value="Sequential">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ListBox Name="CandidateListbox" ItemsSource="{Binding Candidates, Mode=TwoWay}" Grid.Row="3" AllowDrop="True" MouseMove="CandidateList_MouseMove" DragOver="CandidateList_DragOver" Drop="CandidateList_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Graviton.SubText.Colour}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="1" CornerRadius="10" Padding="2" Margin="0,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Graviton.DarkTransparentBackground.Colour}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" GroupName="Candidate" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.InstallMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="SelectOne">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.InstallMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="SelectMany">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.InstallMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Sequential">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>

                                        <TextBlock Text="⋮⋮" Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown" Margin="5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.InstallMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Sequential">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Margin="5,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="5,0">
                                            <TextBlock Text="{Binding FileIDs.Count}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:LocalizedString Files}" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Margin="5,0,15,0" Text="{Binding FileSizeUI}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="4" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Name="CancelButton"  Click="Cancel_Click" Margin="5,0">
                        <TextBlock Name="CancelText" Text="{loc:LocalizedString Cancel}" Margin="2"/>
                    </Button>
                    <Button Name="InstallButton"  Click="Install_Click" Margin="5,0">
                        <TextBlock Name="InstallText" Text="{loc:LocalizedString Install}" Margin="2"/>
                    </Button>
                </StackPanel>
               

            </Grid>
        </Border>


    </Grid>
</UserControl>