<UserControl x:Class="Graviton.Saves.ResolveConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="315" d:DesignWidth="650"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="MainGrid" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="5" Text="&#xea74; Save conflict" FontSize="24" FontWeight="Bold" FontFamily="{DynamicResource NerdFont}"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="5" Text="Your local save conflicts with the save stored on RomM." FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}" TextWrapping="Wrap"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Margin="10,10,0,5" Text="&#xf09e0; Server" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource NerdFont}"/>
        <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal" Margin="15,0,0,0">
            <TextBlock Text="Last Modified: " Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
            <TextBlock Text="{Binding ServerUpdatedAt}" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
        </StackPanel>
        <Button Margin="5" Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" Click="KeepRemote_Click">
            <TextBlock Text="Keep server save" FontFamily="{DynamicResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        
        <TextBlock Grid.Column="0" Grid.Row="4" Margin="10,10,0,5" Text="&#xf02ca; Local" FontSize="18" FontWeight="Bold" FontFamily="{DynamicResource NerdFont}"/>
        <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal" Margin="15,0,0,0">
            <TextBlock Text="Last Modified: " Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
            <TextBlock Text="{Binding LocalUpdatedAt}" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
        </StackPanel>
        <Button Margin="5" Grid.Column="1" Grid.Row="5" VerticalAlignment="Top" Click="KeepLocal_Click">
            <TextBlock Text="Keep local save" FontFamily="{DynamicResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Button Margin="5,40,5,5" Grid.Column="1" Grid.Row="6" VerticalAlignment="Center" Click="Skip_Click">
            <TextBlock Text="Skip" FontFamily="{DynamicResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

    </Grid>
</UserControl>