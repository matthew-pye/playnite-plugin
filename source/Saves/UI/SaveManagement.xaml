<UserControl x:Class="Graviton.Saves.SaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="900" d:DesignWidth="1600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type TreeView}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeView}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- #region ToolBar -->
        <StackPanel Grid.Row="0">
            <TextBlock Name="TitleText" FontSize="32" FontWeight="Bold" Margin="5" Text="Save Management"/>
            <Separator Margin="0,0,0,10"/>

            <Grid Margin="10,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Name="BackButton" Click="Back_Click" Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock Name="BackText" Text="&#xf030d; Back" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="RefreshButton" Click="Refresh_Click" Margin="0,0,10,0">
                        <TextBlock Name="RefreshText" Text="&#xf46a; Refresh" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Grid>
                        <TextBox MinWidth="100" Width="450" MaxWidth="450" VerticalContentAlignment="Center" x:Name="SaveFilterBox" TextChanged="SaveFilterBox_TextChanged"/>
                        <TextBlock IsHitTestVisible="False" Text="{loc:LocalizedString FilterByGameName}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource Graviton.SubText.Colour}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SaveFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Name="CreateNewSaveButton" Click="CreateNewSave_Click" Margin="0,0,10,0" HorizontalAlignment="Right">
                        <TextBlock Name="CreateNewSaveText" Text="&#xea7f; Create New Save" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Name="TrackArchivedSaveButton" Click="TrackArchivedSave_Click" Margin="0,0,10,0" HorizontalAlignment="Right">
                        <TextBlock Name="TrackArchivedSaveText" Text="&#xf1763; Track Archived Save" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Separator Margin="0,0,0,10"/>
        </StackPanel>
        <!-- #endregion -->

        <!-- #region Save Management -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--#region Save Stats -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Synced" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="SyncedSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Needs Upload" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="LocalNewerSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Needs Download" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="RemoteNewerSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Conflicts" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="ConflictedSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.ErrorAccent.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="New on Server" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="ServerOnlySavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="New on Disk" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="LocalOnlySavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                </Grid>
                    <!-- #endregion -->

                <!--#region SaveList -->
                <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="8">

                        <TextBlock Name="NoSavesText" Text="No saves" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Visibility="Collapsed" Margin="0,10"/>
                        <ProgressBar Name="LoadingBar" Margin="10" Width="Auto" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>

                        <!--#region Saves -->
                        <ItemsControl Name="SavesItemControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder" CornerRadius="10" Margin="0,3" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="1" SnapsToDevicePixels="True">
                                        
                                        <StackPanel>

                                            <!-- #region Row Summary -->
                                            <Border Cursor="Hand" MouseLeftButtonUp="SaveRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Graviton.DarkTransparentBackground.Colour}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Graviton.TransparentMouseOverBackground.Colour}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="10,10,10,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding Enabled}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Graviton.TransparentBackground.Colour}" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xf0193;" FontFamily="{DynamicResource NerdFont}" FontSize="16" Foreground="{DynamicResource Graviton.SubText.Colour}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GameName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Filename}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,6"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Slot badge -->
                                                            <Border CornerRadius="10" Background="{DynamicResource Graviton.RomM.Colour}" Padding="8,2" Margin="0,0,6,0">
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource Graviton.Text.Colour}" Text="{Binding Slot, StringFormat='Slot: {0}'}"/>
                                                            </Border>

                                                            <!-- Sync status badge -->
                                                            <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.SuccessBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.InfoBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.WarnBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.ErrorBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.WarnBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.InfoBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="TempRestored">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.SpecialBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="MissingFiles">
                                                                                <Setter Property="Background" Value="{DynamicResource Graviton.SpecialBackground.Colour}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" TextAlignment="Center" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontFamily" Value="{DynamicResource NerdFont}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                                            <Setter Property="Text" Value="Unknown"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Success.Colour}"/>
                                                                                    <Setter Property="Text" Value="Synced"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                                    <Setter Property="Text" Value="Needs Upload"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                                                                    <Setter Property="Text" Value="Needs Download"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Error.Colour}"/>
                                                                                    <Setter Property="Text" Value="Conflicted"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                                                                    <Setter Property="Text" Value="&#xebaa; New on Server"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                                    <Setter Property="Text" Value="&#xf1276; New on Disk"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="TempRestored">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                                    <Setter Property="Text" Value="Temp Restored"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="MissingFiles">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                                    <Setter Property="Text" Value="Missing Files"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <!-- Size badge -->
                                                            <Border CornerRadius="10" Background="{DynamicResource Graviton.TransparentBackground.Colour}" Padding="8,2">
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource Graviton.SubText.Colour}" Text="{Binding FileSizeString}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LastSyncedUI}" FontSize="13" Foreground="{DynamicResource Graviton.Text.Colour}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding LastSyncedAt}" FontSize="11" Foreground="{DynamicResource Graviton.SubSubText.Colour}" HorizontalAlignment="Right"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Click="SyncSave_Click" Margin="4,0" VerticalAlignment="Center" IsEnabled="{Binding Enabled}" Style="{StaticResource Graviton.IconButton}">
                                                            <TextBlock FontSize="18" Padding="3,2" TextAlignment="Center" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontFamily" Value="{DynamicResource NerdFont}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource Graviton.SubText.Colour}"/>
                                                                        <Setter Property="Text" Value="&#xf128;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                                                <Setter Property="Text" Value="&#xf46a;"/>
                                                                                <Setter Property="ToolTip" Value="Sync"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                                                <Setter Property="Text" Value="&#xf40a;"/>
                                                                                <Setter Property="ToolTip" Value="Sync (Upload)"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                                                <Setter Property="Text" Value="&#xf409;"/>
                                                                                <Setter Property="ToolTip" Value="Sync (Download)"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Error.Colour}"/>
                                                                                <Setter Property="Text" Value="&#xea6c;"/>
                                                                                <Setter Property="ToolTip" Value="Resolve Conflict"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                                <Setter Property="Text" Value="&#xeac2;"/>
                                                                                <Setter Property="ToolTip" Value="Start tracking (Download)"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                                <Setter Property="Text" Value="&#xf44c;"/>
                                                                                <Setter Property="ToolTip" Value="Start tracking (Upload)"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="TempRestored">
                                                                                <Setter Property="Text" Value="&#xf0031;"/>
                                                                                <Setter Property="ToolTip" Value="Upload restored save"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="MissingFiles">
                                                                                <Setter Property="Text" Value="&#xf128;"/>
                                                                                <Setter Property="ToolTip" Value="Resolve missing files"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <Button Click="DeleteSave_Click" Margin="4,0" VerticalAlignment="Center" Style="{StaticResource Graviton.IconButton}" Foreground="{DynamicResource Graviton.Error.Colour}">
                                                            <TextBlock Name="DeleteSaveIcon" FontSize="18" Text="&#xf05e8;" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource NerdFont}"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="5" FontFamily="{DynamicResource NerdFont}" FontSize="14" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Text" Value="&#xf078;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#xf077;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <!-- #endregion -->

                                            <Separator Background="{DynamicResource Graviton.TransparentBackground.Colour}" Margin="5"/>

                                            <!-- #region Expanded View-->
                                            <Border Padding="14,12" Background="Transparent" CornerRadius="0,0,9,9" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                                                        <Grid Margin="0,0,0,8">
                                                            <TextBlock Text="File Paths" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Margin="0,0,6,0" Click="AddFileToSave_Click" Style="{StaticResource Graviton.IconButton}" ToolTip="Add file">
                                                                    <TextBlock FontFamily="{DynamicResource NerdFont}" FontSize="14" Text="&#xea7f; File"/>
                                                                </Button>
                                                                <Button Click="AddFolderToSave_Click" Style="{StaticResource Graviton.IconButton}" ToolTip="Add folder">
                                                                    <TextBlock FontFamily="{DynamicResource NerdFont}" FontSize="14" Text="&#xea7f; Folder"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <ListBox Name="SourcePaths" ItemsSource="{Binding SourceFilePaths}" MaxHeight="150">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                                                                        <Button Grid.Column="1" Click="RemoveSourcePath_Click" Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext}" Style="{StaticResource Graviton.IconButton}" Padding="4,0" ToolTip="Remove">
                                                                            <TextBlock FontFamily="{DynamicResource NerdFont}" FontSize="12" Text="&#xf05e8;" Foreground="{DynamicResource Graviton.Error.Colour}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>

                                                    <Separator Grid.Column="1" Grid.Row="0" Width="1" Background="{DynamicResource Graviton.TransparentBackground.Colour}" Margin="6,0"/>

                                                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="10,0,0,0">
                                                        <TextBlock Text="History" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                                                        <ScrollViewer MaxHeight="150">
                                                            <ItemsControl ItemsSource="{Binding HistoricSaves}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding LastSyncedUI}" FontSize="14" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                                                                                    <TextBlock Text="{Binding LastSyncedAt}" FontSize="11" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                                                </StackPanel>

                                                                                <Border Grid.Column="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" Visibility="Hidden">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock FontSize="11" Margin="6,3" Text="&#xf08d; Current" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Graviton.Info.Colour}"/>
                                                                                </Border>

                                                                                <Button Grid.Column="2" Click="RevertToHistoricSave_Click" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                            <Setter Property="IsEnabled" Value="True"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                    <TextBlock Text="Switch to this" Padding="4,2" FontSize="12" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                                                                                </Button>
                                                                            </Grid>
                                                                            <Separator Margin="0,4" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <TextBlock TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                                    <Setter Property="Text" Value="No save history"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HistoricSaves.Count}" Value="0">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HistoricSaves.Count}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Separator Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,14,0,4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Manual sync:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                        <Button Margin="4,0,0,0" ToolTip="Uploads the local save, overwriting whatever is on the server">
                                                            <TextBlock FontSize="16" Text="&#xf40a; Force Upload" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.Warn.Colour}" Padding="4,2"/>
                                                        </Button>
                                                        <Button Margin="4,0,0,0" ToolTip="Downloads the server save, overwriting the local copy">
                                                            <TextBlock FontSize="16" Text="&#xf409; Force Download" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.Warn.Colour}" Padding="4,2"/>
                                                        </Button>
                                                        <Separator Width="1" Margin="10,0" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                                        <Button Margin="0,0,0,0" ToolTip="Makes a permanent copy of the save that future syncs and auto-cleanup will never overwrite or delete">
                                                            <TextBlock FontSize="16" Text="&#xebcc; Duplicate to archive" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}" Padding="4,2"/>
                                                        </Button>
                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                            <!--#endregion-->

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- #endregion -->

                    </StackPanel>
                </Border>
                <!-- #endregion -->

            </Grid>
            
            
        </ScrollViewer>
        <!-- #endregion -->

    </Grid>
</UserControl>