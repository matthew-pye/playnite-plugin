<UserControl x:Class="Graviton.Saves.SaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="900" d:DesignWidth="1600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type TreeView}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeView}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- #region ToolBar -->
        <StackPanel Grid.Row="0">
            <TextBlock Name="TitleText" FontSize="32" FontWeight="Bold" Margin="5" Text="Save Management"/>
            <Separator Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                <Button Name="BackButton" Click="Back_Click" Margin="0,0,10,0" Visibility="Collapsed">
                    <TextBlock Name="BackText" Text="&#xf030d; Back" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Name="RefreshButton" Click="Refresh_Click" Margin="0,0,10,0">
                    <TextBlock Name="RefreshText" Text="&#xf46a; Refresh" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Grid>
                    <TextBox Width="220" VerticalContentAlignment="Center" x:Name="SaveFilterBox" TextChanged="SaveFilterBox_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="{loc:LocalizedString FilterByGameName}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource Graviton.SubText.Colour}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SaveFilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <Separator Margin="0,0,0,10"/>
        </StackPanel>
        <!-- #endregion -->

        <!-- #region Save Management -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--#region Save Stats -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Synced" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="SyncedSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Local Newer" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="LocalNewerSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Remote Newer" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="RemoteNewerSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Conflicts" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="ConflictedSavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.ErrorAccent.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Untracked Server Saves" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="ServerOnlySavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                        <StackPanel Margin="5">
                            <TextBlock Text="Untracked Detected Saves" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                            <TextBlock Name="LocalOnlySavesCount" FontSize="28" Text="0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                        </StackPanel>
                    </Border>

                </Grid>
                    <!-- #endregion -->

                <!--#region Saves -->
                <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="5,5,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Margin="5" Visibility="Hidden"/>
                            <TextBlock Grid.Column="1" Text="Savefile" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                            <TextBlock Grid.Column="2" Text="Status" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                            <TextBlock Grid.Column="3" Text="Last Modified" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                        </Grid>
                        <Separator Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                        <TextBlock Name="NoSavesText" Text="No saves" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Visibility="Collapsed"/>
                        <ProgressBar Name="LoadingBar" Margin="10" Width="Auto" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>

                        <ItemsControl Name="SavesItemControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="4*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" IsChecked="{Binding Enabled}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <Button Click="Click_ShowSaveDetails" Margin="5" HorizontalAlignment="Left">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    </ContentPresenter>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="16" FontFamily="{DynamicResource NerdFont}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Text" Value="&#xf078;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="&#xf077;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding GameName}" Margin="5,0" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                                                </StackPanel>
                                                
                                            </Button>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Slot: " Margin="24,0,0,0" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                <TextBlock Text="{Binding Slot}" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--#region Save Status -->
                                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.SuccessBackground.Colour}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.InfoBackground.Colour}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.WarnBackground.Colour}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.ErrorBackground.Colour}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.WarnBackground.Colour}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                            <Setter Property="Background" Value="{DynamicResource Graviton.InfoBackground.Colour}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" Margin="5,3" TextAlignment="Center"  TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{DynamicResource NerdFont}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                        <Setter Property="Text" Value="Unknown"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Success.Colour}"/>
                                                                <Setter Property="Text" Value="Synced"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                <Setter Property="Text" Value="Local Newer"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                                                <Setter Property="Text" Value="Remote Newer"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Error.Colour}"/>
                                                                <Setter Property="Text" Value="Conflicted"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                                                <Setter Property="Text" Value="&#xebaa; Server Only"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.Info.Colour}"/>
                                                                <Setter Property="Text" Value="&#xf1276; Auto Detected"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!--#endregion-->

                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding LastSyncedString}" Foreground="{DynamicResource Graviton.Text.Colour}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding FileSizeString}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <Button Margin="5" Click="SyncSave_Click" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="{Binding Enabled}">
                                                <TextBlock FontSize="18" Padding="3,2" TextAlignment="Center"  TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="{DynamicResource NerdFont}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Graviton.Text.Colour}"/>
                                                            <Setter Property="Text" Value="&#xf128;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Synced">
                                                                    <Setter Property="Text" Value="&#xf46a;"/>
                                                                    <Setter Property="ToolTip" Value="Sync"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="LocalNewer">
                                                                    <Setter Property="Text" Value="&#xf40a;"/>
                                                                    <Setter Property="ToolTip" Value="Sync (Upload)"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="RemoteNewer">
                                                                    <Setter Property="Text" Value="&#xf409;"/>
                                                                    <Setter Property="ToolTip" Value="Sync (Download)"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Conflicted">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Graviton.Error.Colour}"/>
                                                                    <Setter Property="Text" Value="&#xea6c;"/>
                                                                    <Setter Property="ToolTip" Value="Resolve Conflict"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="ServerOnly">
                                                                    <Setter Property="Text" Value="&#xeac2;"/>
                                                                    <Setter Property="ToolTip" Value="Start tracking (Download)"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="UntrackedLocal">
                                                                    <Setter Property="Text" Value="&#xf44c;"/>
                                                                    <Setter Property="ToolTip" Value="Start tracking (Upload)"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </StackPanel>

                                        <!-- #region Expanded View-->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Padding="12,10" Background="{DynamicResource Graviton.DarkTransparentMouseOverBackground.Colour}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                                                    <TextBlock Text="Files" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                    <TreeView VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-6,0,0,0" ItemsSource="{Binding SaveDirectoryTrees}">
                                                        <TreeView.Resources>
                                                            <HierarchicalDataTemplate DataType="{x:Type msav:SaveDirectoryTree}" ItemsSource="{Binding Children}">
                                                                <TextBlock FontSize="12" Text="{Binding Name}" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                                                            </HierarchicalDataTemplate>
                                                        </TreeView.Resources>
                                                    </TreeView>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                                                    <TextBlock Text="History" FontSize="16" Margin="0,0,0,6" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                    <ScrollViewer MaxHeight="100">
                                                        <ItemsControl ItemsSource="{Binding HistoricSaves}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <Grid>
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding LastSyncedString}" Foreground="{DynamicResource Graviton.Text.Colour}"/>
                                                                                <TextBlock Text="{Binding FileSizeString}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Row="0" Grid.Column="2" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" Visibility="Hidden">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{DynamicResource Graviton.Trace.Colour}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock FontSize="12" Margin="5,3" Text="&#xf08d; Current" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Graviton.Info.Colour}"/>

                                                                            </Border>
                                                                            <Button Click="RevertToHistoricSave_Click"  VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                                <TextBlock Text="Switch to this" Padding="4,2" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                                                                            </Button>
                                                                        </Grid>
                                                                        <Separator Margin="4" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                                                    </StackPanel>
                                                                    
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    
                                                    <TextBlock TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Graviton.SubSubText.Colour}"/>
                                                                <Setter Property="Text" Value="No save history"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HistoricSaves.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HistoricSaves.Count}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Separator Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                                                <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,10,0,5" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Margin="4,0,0,0">
                                                        <TextBlock FontSize="16" Text="&#xf40a; Force Upload" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}" Padding="4,2"/>
                                                    </Button>
                                                    <Button Margin="4,0,0,0">
                                                        <TextBlock FontSize="16" Text="&#xf409; Force Download" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}" Padding="4,2"/>
                                                    </Button>
                                                    <Button Margin="4,0,0,0" ToolTip="Makes a permanent copy of the save that future syncs and auto-cleanup will never overwrite or delete">
                                                        <TextBlock FontSize="16" Text="&#xebcc; Duplicate to archive" FontFamily="{DynamicResource NerdFont}" Foreground="{DynamicResource Graviton.SubText.Colour}" Padding="4,2"/>
                                                    </Button>
                                                </StackPanel>


                                            </Grid>
                                        </Border>
                                        <!--#endregion-->
                                        
                                        <Separator Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5" VerticalAlignment="Bottom" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>
                <!-- #endregion -->

            </Grid>
            
            
        </ScrollViewer>
        <!-- #endregion -->

    </Grid>
</UserControl>