<UserControl x:Class="Graviton.Saves.SaveManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:sav="clr-namespace:Graviton.Saves"
             xmlns:savmodels="clr-namespace:Graviton.Models.Saves"
             xmlns:playmodels="clr-namespace:Graviton.Models.RomM.PlaySessions"
             xmlns:local="clr-namespace:Graviton"
             xmlns:loc="clr-namespace:Playnite"
             xmlns:psdk="clr-namespace:Playnite.Desktop;assembly=Playnite.SDK"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <sav:SingleGameSaveManagement x:Name="SingleGameManagementUI" Visibility="Collapsed"/>
        
        <Grid Name="SaveManagementUI">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:LocalizedString SaveManagementTitle}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:LocalizedString SaveManagementSubText}" FontSize="14" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                </StackPanel>

                <Button Name="ScanForSavesButton" Click="ScanForSaves_Click" Grid.Column="1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Name="ScanForSavesText" Text="{loc:LocalizedString ScanForSaves}" Margin="2"/>
                </Button>
            </Grid>

            <!-- Save Actions Overview -->
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TODO replace numbers with proper bindings -->

                <Border Grid.Column="0" Style="{DynamicResource Graviton.SettingsCard}" Padding="5">
                    <StackPanel>
                        <TextBlock Text="12" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:LocalizedString NeedsAttention}" FontSize="14" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource Graviton.SettingsCard}" Padding="5">
                    <StackPanel>
                        <TextBlock Text="8" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:LocalizedString Discovered}" FontSize="14" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{DynamicResource Graviton.SettingsCard}" Padding="5">
                    <StackPanel>
                        <TextBlock Text="12" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:LocalizedString InSync}" FontSize="14" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tab Controls -->
            <Grid Grid.Row="2" Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="NeedAttentionTabButton" Click="NeedAttentionTab_Click" Margin="5" VerticalAlignment="Center">
                        <TextBlock Name="NeedAttentionTabText" Text="{loc:LocalizedString NeedsAttention}" Margin="2"/>
                    </Button>

                    <Button Name="DiscoveredTabButton" Click="DiscoveredTab_Click" Margin="5" VerticalAlignment="Center">
                        <TextBlock Name="DiscoveredTabText" Text="{loc:LocalizedString Discovered}" Margin="2"/>
                    </Button>

                    <Button Name="AllGamesTabButton" Click="AllGamesTab_Click" Margin="5" VerticalAlignment="Center">
                        <TextBlock Name="AllGamesTabText" Text="{loc:LocalizedString AllGames}" Margin="2"/>
                    </Button>
                </StackPanel>

                <TextBox Name="GameFilterBox" MinWidth="100" Width="450" MaxWidth="450" Grid.Column="1" HorizontalAlignment="Right" VerticalContentAlignment="Center"  TextChanged="SaveFilterBox_TextChanged" local:Placeholder.Text="{loc:LocalizedString FilterGames}"/>
            </Grid>

            <!-- Games List -->
            <Border Name="GamesList" Grid.Row="3" Style="{DynamicResource Graviton.SettingsCard}" Padding="5" Visibility="Collapsed">
                <ScrollViewer>
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{DynamicResource Graviton.SettingsCard}" Padding="2" Margin="5"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GameName" FontSize="16" FontWeight="SemiBold"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Emualtor" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            <TextBlock Text="ActivePlaythough" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            <TextBlock Text="TotalPlaythroughs" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                            <TextBlock Text="{loc:LocalizedString PlaythroughsText}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">

                                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="6" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,10,5,5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Graviton.WarnBackground.Colour}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Graviton.Warn.Colour}"/>
                                                    <Style.Triggers>

                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" Margin="5,2,5,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Remote Ahead"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Graviton.Warn.Colour}"/>

                                                        <Style.Triggers>

                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Button Name="ViewGameButton" Click="ViewGame_Click" Margin="5" VerticalAlignment="Center">
                                            <TextBlock Name="ViewGameTabText" Text="{loc:LocalizedString View}" Margin="2"/>
                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Discovery List -->
            <sav:SaveDiscoveryView x:Name="SaveDiscoveryUI" Visibility="Collapsed"/>
            
        </Grid>
    </Grid>
    
    
</UserControl>
