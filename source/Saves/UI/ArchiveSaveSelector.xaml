<UserControl x:Class="Graviton.Saves.ArchiveSaveSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="315" d:DesignWidth="650"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="MainGrid" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >
        
        <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Archived saves" FontSize="24" Margin="5" FontWeight="Bold" Foreground="{DynamicResource Graviton.Text.Colour}"/>

                <Separator Grid.Row="1" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                <TextBlock Grid.Row="2" Name="NoSavesText" Text="No saves" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Visibility="Collapsed"/>
                <ProgressBar Grid.Row="2" Name="LoadingBar" Margin="10" Width="Auto" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>

                <ScrollViewer Grid.Row="3">
                    <ItemsControl Name="SavesItemControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" CornerRadius="10" Margin="0,3" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" BorderThickness="1" SnapsToDevicePixels="True">

                                    <Grid Margin="10,10,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Graviton.TransparentBackground.Colour}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xf0193;" FontFamily="{DynamicResource NerdFont}" FontSize="16" Foreground="{DynamicResource Graviton.SubText.Colour}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ROMName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Graviton.Text.Colour}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource Graviton.SubSubText.Colour}" TextTrimming="CharacterEllipsis" Margin="0,1,0,6"/>

                                             <Border CornerRadius="10" Background="{DynamicResource Graviton.TransparentBackground.Colour}" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Graviton.SubText.Colour}" Text="{Binding FileSizeUI}"/>
                                             </Border>
                                           
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdatedAtUI}" FontSize="13" Foreground="{DynamicResource Graviton.Text.Colour}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding UpdatedAt}" FontSize="11" Foreground="{DynamicResource Graviton.SubSubText.Colour}" HorizontalAlignment="Right"/>
                                        </StackPanel>


                                        <Button Grid.Column="3" Margin="5" Click="DownloadArchiveSave_Click">
                                            <TextBlock Text="&#xeac2; Download" FontSize="12" FontFamily="{DynamicResource NerdFont}" Padding="3,2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Separator Grid.Row="4" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                
                <Button Grid.Row="5" Margin="5" Click="Cancel_Click" HorizontalAlignment="Right">
                    <TextBlock Text="Cancel" Padding="3,2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>