<UserControl x:Class="Graviton.Saves.CreateSaveSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:s="clr-namespace:Graviton.Settings"
             xmlns:sav="clr-namespace:Graviton.Saves"     
             xmlns:msav="clr-namespace:Graviton.Models.Saves"     
             xmlns:m="clr-namespace:Graviton.Models"
             xmlns:playnite="clr-namespace:Playnite;assembly=Playnite.SDK"
             xmlns:loc="clr-namespace:Playnite"
             d:DesignHeight="450" d:DesignWidth="800"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Graviton;component/ThemingDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TreeView}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeView}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type TreeViewItem}">
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="MainGrid" Canvas.Left="0" Canvas.Top="0" Width="{Binding ActualWidth, ElementName=SettingsCanvas}" Height="{Binding ActualHeight, ElementName=SettingsCanvas}" >

        <Border Grid.Row="1" Margin="5" BorderBrush="{DynamicResource Graviton.TransparentBackground.Colour}" Background="{DynamicResource Graviton.DarkTransparentBackground.Colour}" BorderThickness="1">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Create New Save" FontSize="24" Margin="5" FontWeight="Bold" Foreground="{DynamicResource Graviton.Text.Colour}"/>

                <Separator Grid.Row="1" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <StackPanel Margin="5">
                        <TextBlock Text="Mapping"  FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                        <ComboBox Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="5" Width="350" Tag="No Mapping Selected" ItemsSource="{Binding Mappings}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMapping, Mode=TwoWay}" SelectionChanged="MappingComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Game" FontWeight="Bold" Foreground="{DynamicResource Graviton.SubText.Colour}"/>
                        <ComboBox Name="ROMsComboBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="5" Width="350" Tag="No ROM Selected" DisplayMemberPath="Name" SelectedItem="{Binding SelectedROM, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
                
                <Separator Grid.Row="3" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                
                <TextBlock Grid.Row="4" Name="NoMappingText" Text="No Mapping Selected" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Visibility="Visible"/>
                <TextBlock Grid.Row="4" Name="NoFilesText" Text="No Files Found" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Graviton.SubSubText.Colour}" Visibility="Collapsed"/>
                <ProgressBar Grid.Row="4" Name="LoadingBar" Margin="10" Width="Auto" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>

                <TreeView Name="FileTree" Grid.Row="5" Margin="0,10,0,0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type msav:SaveDirectoryTree}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="SaveFileCheckBox_Click" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Graviton.SubText.Colour}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <Separator Grid.Row="6" Background="{DynamicResource Graviton.TransparentBackground.Colour}"/>
                
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Name="Save" Click="SyncNewSave_Click" Margin="0,0,10,0" HorizontalAlignment="Right">
                        <TextBlock Text="Create Save" Padding="3,2" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Name="Cancel" Click="Cancel_Click" Margin="0,0,10,0" HorizontalAlignment="Right">
                        <TextBlock Text="Cancel" Padding="3,2" FontFamily="{StaticResource NerdFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>


    </Grid>
</UserControl>