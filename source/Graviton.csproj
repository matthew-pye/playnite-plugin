<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Downloads\**" />
    <EmbeddedResource Remove="Downloads\**" />
    <None Remove="Downloads\**" />
    <Page Remove="Downloads\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\*.ftl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- extension.toml is generated into the output directory during build.
       Do not copy the source file directly. -->
  <ItemGroup>
    <None Update="extension.toml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <None Update="pluginicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="pluginiconBW.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="profile.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>

    <None Update="readme.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emunight.SDK" Version="1.0.0-alpha1" />
    <PackageReference Include="GrindCore.SharpCompress" Version="0.48.0" />
    <PackageReference Include="Playnite.SDK" Version="11.0.0-zeta10" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Graviton.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

 <UsingTask TaskName="UpdateExtensionVersion" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

  <ParameterGroup>
    <SourceFile ParameterType="System.String" Required="true" />
    <TemplateFile ParameterType="System.String" Required="true" />
    <OutputFile ParameterType="System.String" Required="true" />
  </ParameterGroup>

  <Task>
    <Reference Include="System" />
    <Reference Include="System.Core" />

    <Using Namespace="System" />
    <Using Namespace="System.IO" />
    <Using Namespace="System.Text.RegularExpressions" />

    <Code Type="Fragment" Language="cs"><![CDATA[
      var source = File.ReadAllText(SourceFile);

      var match = Regex.Match(
          source,
          @"new Version\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)");

      if (!match.Success)
      {
          Log.LogError(
              "Could not find 'new Version(x,y,z)' in " + SourceFile);
          return false;
      }

      var version = string.Format(
          "{0}.{1}.{2}",
          match.Groups[1].Value,
          match.Groups[2].Value,
          match.Groups[3].Value);

      var toml = File.ReadAllText(TemplateFile);

      toml = Regex.Replace(
          toml,
          @"(?m)^version\s*=\s*[""'][^""']*[""']\s*$",
          "version = \"" + version + "\"");

      var directory = Path.GetDirectoryName(OutputFile);

      if (!string.IsNullOrEmpty(directory))
      {
          Directory.CreateDirectory(directory);
      }

      File.WriteAllText(OutputFile, toml);

      Log.LogMessage(
          MessageImportance.High,
          "Generated extension.toml with version " + version);

      return true;
    ]]></Code>
  </Task>
</UsingTask>

<Target Name="GenerateExtensionToml" BeforeTargets="CopyFilesToOutputDirectory">

  <UpdateExtensionVersion SourceFile="$(MSBuildProjectDirectory)\GravitonPlugin.cs" TemplateFile="$(MSBuildProjectDirectory)\extension.toml" OutputFile="$(TargetDir)extension.toml" />

</Target>

</Project>