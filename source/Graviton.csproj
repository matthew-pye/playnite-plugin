<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Downloads\**" />
    <EmbeddedResource Remove="Downloads\**" />
    <None Remove="Downloads\**" />
    <Page Remove="Downloads\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\*.ftl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- extension.toml is generated into the output directory during build.
       Do not copy the source file directly. -->
  <ItemGroup>
    <None Update="extension.toml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <None Update="pluginicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="pluginiconBW.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="profile.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>

    <None Update="readme.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emunight.SDK" Version="1.0.0-alpha2" />
    <PackageReference Include="GrindCore.SharpCompress" Version="0.50.5" />
    <PackageReference Include="Playnite.SDK" Version="11.0.0-alpha14" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Graviton.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <!--
    extension.toml is generated from the constants at the top of GravitonPlugin.cs.
  -->
  <UsingTask TaskName="GenerateExtensionManifest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <TemplateFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <ExtensionVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />

      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(SourceFile);

        var idMatch = Regex.Match(source, @"\bId\s*=\s*""([^""]+)""\s*;");
        var nameMatch = Regex.Match(source, @"\bExternalIdName\s*=\s*""([^""]+)""\s*;");

        if (!idMatch.Success)
        {
            Log.LogError("Could not find string constant 'Id' in " + SourceFile);
            return false;
        }

        if (!nameMatch.Success)
        {
            Log.LogError("Could not find string constant 'ExternalIdName' in " + SourceFile);
            return false;
        }

        var id = idMatch.Groups[1].Value;
        var name = nameMatch.Groups[1].Value;

        var versionMatch = Regex.Match(
            source,
            @"\bVersion\s*=\s*new\s+Version\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)\s*;");

        if (!versionMatch.Success)
        {
            Log.LogError("Could not find 'Version = new Version(x, y, z)' in " + SourceFile);
            return false;
        }

        ExtensionVersion = string.Format(
            "{0}.{1}.{2}",
            versionMatch.Groups[1].Value,
            versionMatch.Groups[2].Value,
            versionMatch.Groups[3].Value);

        var toml = File.ReadAllText(TemplateFile);

        toml = Regex.Replace(toml, @"(?m)^id\s*=\s*[""'][^""']*[""']\s*$", "id = \"" + id + "\"");
        toml = Regex.Replace(toml, @"(?m)^name\s*=\s*[""'][^""']*[""']\s*$", "name = \"" + name.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"");
        toml = Regex.Replace(toml, @"(?m)^version\s*=\s*[""'][^""']*[""']\s*$", "version = \"" + ExtensionVersion + "\"");

        var directory = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(directory))
        {
            Directory.CreateDirectory(directory);
        }

        File.WriteAllText(OutputFile, toml);

        Log.LogMessage(MessageImportance.High, "Generated extension.toml: " + id + " / " + name + " / " + ExtensionVersion);

        return true;
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="PrunePlayniteRuntimeDirectories" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <RuntimeRoot ParameterType="System.String" Required="true" />
      <RuntimeToKeep ParameterType="System.String" Required="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />

      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!Directory.Exists(RuntimeRoot))
        {
            return true;
        }

        foreach (var runtimeDirectory in Directory.GetDirectories(RuntimeRoot))
        {
            var runtimeName = Path.GetFileName(runtimeDirectory);
            if (string.Equals(runtimeName, RuntimeToKeep, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            Directory.Delete(runtimeDirectory, true);
            Log.LogMessage(MessageImportance.Normal, "Removed unused runtime: " + runtimeName);
        }

        return true;
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <!--
      Collaborators can either place Toolbox.exe in ../tools, set the
      PLAYNITE_TOOLBOX environment variable, or pass -p:PlayniteToolbox=...
    -->
    <PlayniteToolbox Condition="'$(PlayniteToolbox)' == '' and '$(PLAYNITE_TOOLBOX)' != ''">$(PLAYNITE_TOOLBOX)</PlayniteToolbox>
    <PlayniteToolbox Condition="'$(PlayniteToolbox)' == '' and Exists('$(MSBuildProjectDirectory)\..\tools\Toolbox.exe')">$(MSBuildProjectDirectory)\..\tools\Toolbox.exe</PlayniteToolbox>

    <!-- Keep every packaging artifact under bin/<Configuration>. No trailing
         slash here: a trailing backslash inside a quoted Exec argument can
         escape the closing quote on Windows. -->
    <PlayniteBuildRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\bin\$(Configuration)'))</PlayniteBuildRoot>
    <PlaynitePackageStageDir>$(PlayniteBuildRoot)\package</PlaynitePackageStageDir>
  </PropertyGroup>

  <Target Name="GenerateExtensionToml" AfterTargets="Build">
    <GenerateExtensionManifest
        SourceFile="$(MSBuildProjectDirectory)\GravitonPlugin.cs"
        TemplateFile="$(MSBuildProjectDirectory)\extension.toml"
        OutputFile="$(TargetDir)extension.toml">
      <Output TaskParameter="ExtensionVersion" PropertyName="GravitonExtensionVersion" />
    </GenerateExtensionManifest>
  </Target>

  <!-- Release output itself is Windows x64-only. Debug keeps the full NuGet
       output so development/debugging is not altered. -->
  <Target Name="PruneReleaseRuntimeAssets"
          Condition="'$(Configuration)' == 'Release'"
          DependsOnTargets="GenerateExtensionToml">
    <PrunePlayniteRuntimeDirectories
        RuntimeRoot="$(TargetDir)runtimes"
        RuntimeToKeep="win-x64" />

    <Message Importance="High"
             Text="Pruned Release runtimes; keeping only win-x64 in $(TargetDir)runtimes" />
  </Target>

  <Target Name="StagePlaynitePackage"
          Condition="'$(Configuration)' == 'Release'"
          DependsOnTargets="PruneReleaseRuntimeAssets">
    <RemoveDir Directories="$(PlaynitePackageStageDir)" Condition="Exists('$(PlaynitePackageStageDir)')" />
    <MakeDir Directories="$(PlaynitePackageStageDir)" />

    <!-- The Release output has already been pruned to win-x64, so stage the
         complete plugin output as-is. -->
    <ItemGroup>
      <PlaynitePackageFiles Include="$(TargetDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PlaynitePackageFiles)"
          DestinationFiles="@(PlaynitePackageFiles->'$(PlaynitePackageStageDir)\%(RecursiveDir)%(Filename)%(Extension)')" />

    <Message Importance="High"
             Text="Staged Windows x64 Playnite package at $(PlaynitePackageStageDir)" />
  </Target>

  <Target Name="PackPlayniteExtension"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'"
          DependsOnTargets="StagePlaynitePackage">
    <Error Condition="'$(PlayniteToolbox)' == '' or !Exists('$(PlayniteToolbox)')"
           Text="Playnite Toolbox.exe was not found. Put it in tools\Toolbox.exe beside the source folder (recommended), set PLAYNITE_TOOLBOX, or pass -p:PlayniteToolbox=..." />

    <PropertyGroup>
      <PlaynitePackageFile>$(PlayniteBuildRoot)\Graviton-$(GravitonExtensionVersion).pext2</PlaynitePackageFile>
    </PropertyGroup>

    <Message Importance="High"
             Text="Packing Playnite extension to $(PlaynitePackageFile)" />

    <Exec Command="&quot;$(PlayniteToolbox)&quot; pack &quot;$(PlaynitePackageStageDir)&quot; &quot;$(PlaynitePackageFile)&quot;" />
  </Target>

</Project>